pipeline {
agent {
node {
label 'built-in'
customWorkspace '/mnt/project'
}
}
environment{
DOCKER = credentials('swaraj')
DOCKER_IMAGE = "dhumalpd2001/project"
IMAGE_TAG = "1.0"
}
stages{
stage('clean workspace'){
steps{
sh '''
echo " cleaning workspace "
rm -rf *
'''
}
}
stage('checkout source code'){
steps{
checkout scm
sh '''
pwd
ls -ltr
'''
}
}
stage('verify installed tools'){
steps{
sh '''
echo "java version"
java -version
echo "maven version"
mvn --version
echo "docker version"
docker --version
echo "aws-cli"
aws --version
'''
}}
stage('build application'){
steps{
sh '''
echo "building java apps"
mvn clean install
echo "build completed sucessfully"
'''
}}
stage('verify war file'){
steps{
sh '''
echo "generated war file"
ls -lh target/
find target -name "*.war"
'''
}
}
stage('upload war to S3'){
steps{
sh '''
echo "uploading war to s3"
aws s3 cp target/*.war s3://poojasbucketmah/one/
echo "war uploaded successfully"
'''
}
}
stage('build docker image'){
steps{
sh '''
echo " building docker image"
docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} .
echo "docker image create successfully"
docker images
'''
}
}
stage('docker hub login'){
steps{
sh '''
echo "docker hub login"
echo "$DOCKER_PSW" | docker login -u "$DOCKER_USR" --password-stdin
'''
}
}
stage('push docker image'){
steps{
sh '''
echo "pushing docker image"
docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
echo "docker image pushed sucessfully"
'''
}
}
}
post{
success{
echo "CI pipeline completed suceessfully"
echo "docker image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
}
failure{
echo "CI pipeline failed"
}
always{
sh 'docker logout || true'
}
}
}
