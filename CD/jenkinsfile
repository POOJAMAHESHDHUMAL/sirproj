pipeline {
agent {
node {
label 'slave-node'
customWorkspace '/mnt/slave_node'
}
}
environment {
DOCKER = credentials('swaraj')
}
stages {
  stage('cleaning workspace'){
  steps{
sh '''
echo "cleaning workspace"
rm -rf *
echo "slave workspace cleaned"
'''
}
}
stage('sourcecode checkout') {
steps{
checkout scm
sh '''
echo "scm checkout done"
ls -ltr
'''
}
}
stage('verify docker') {
steps{
sh '''
echo "docker version"
docker --version
echo "docker compose version"
docker compose version
'''
}
}
stage('docker hub login') {
steps{
sh '''
echo "docker login"
echo "$DOCKER_PSW" | docker login -u "$DOCKER_USR" --password-stdin
'''
}
}
stage('create env file') {
steps{
sh '''
cd  /mnt/slave_node/CD
echo "DOCKER_IMAGE = $DOCKER_IMAGE" > .env
echo "IMAGE_TAG = $IMAGE_TAG" >> .env
cat .env
'''
}
}
stage('deploy application') {
steps{
sh '''
cd  /mnt/slave_node/CD
pwd
docker compose down || true
docker compose pull
docker compose up -d
'''
}
}
stage('verify deplyment') {
steps{
sh '''
pwd
echo "ruuning containers"
cd  /mnt/slave_node/CD
docker ps
echo "docker compose status"
docker compose ps
'''
}
}
}
post{
success{
echo "CD pipeline completed suceessfully"
}
failure{
echo "CD pipeline failed"
}
always{
sh 'docker logout || true'
}
}
}
