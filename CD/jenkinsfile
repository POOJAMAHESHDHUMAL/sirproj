pipeline{
agent{
node{
label 'slave-node'
customWorkspace '/mnt/slave-node'
}
}
environment {
DOCKER = credencials('swaraj');
}
stages{
  stage('cleaning workspace'){
  steps{
sh '''
echo "cleaning workspace"
rm -rf *
echo "slave workspace cleaned"
'''
}
stage('sourcecode checkout'){
steps{
checkout scm
sh '''
echo "scm checkout done"
ls -ltr
'''
}
}
stage('verify docker'){
steps{
sh '''
echo "docker version"
docker --version
echo "docker compose version"
docker compose version

}
}


}
